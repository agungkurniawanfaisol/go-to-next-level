# App
APP_PORT=5173

# MySQL
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_DATABASE=ecoswap
MYSQL_USER=ecoswap
MYSQL_PASSWORD=ecoswap_secret_change_me

# Session (wajib ganti di production publik)
JWT_SECRET=ecoswap-dev-secret-change-me
# false = cookie jalan di http://localhost (Docker demo)
COOKIE_SECURE=false

# Connection string
# - Docker app: otomatis di-override ke mysql:3306 (docker-compose.yml)
# - Dev lokal (npm run dev): pakai 127.0.0.1 + MYSQL_PORT di bawah
DATABASE_URL=mysql://ecoswap:ecoswap_secret_change_me@127.0.0.1:3307/ecoswap
