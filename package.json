{
  "name": "ecoswap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5173",
    "dev:docker": "next dev --hostname 0.0.0.0 --webpack -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "lint": "eslint",
    "db:seed": "npx tsx scripts/generate-seed-data.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:sync": "docker compose exec app npm install",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-pannellum": "^1.1.2-alpha.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
